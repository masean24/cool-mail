# Copy isi ini ke Environment di Coolify (jangan commit file .env asli).
# DATABASE_URL menunjuk ke service db di compose ini.
# Contoh: postgresql://hubify:<POSTGRES_PASSWORD>@db:5432/hubify_mail
DATABASE_URL=postgresql://hubify:CHANGE_ME@db:5432/hubify_mail

# Postgres (service db di compose). Kalau pakai Database bawaan Coolify,
# bagian ini tidak dipakai — hapus service db dan pakai URL dari Coolify.
POSTGRES_DB=hubify_mail
POSTGRES_USER=hubify
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Web publik (wajib HTTPS, tanpa trailing slash)
CORS_ALLOWED_ORIGINS=https://mail.hubify.store
MAIL_SERVER_HOSTNAME=mail.hubify.store

# Secret — generate baru, JANGAN pakai dari repo lama
JWT_SECRET=CHANGE_ME_LONG_RANDOM
INBOX_ACCESS_JWT_SECRET=CHANGE_ME_LONG_RANDOM_2
INBOX_RESERVATION_IP_SALT=CHANGE_ME_LONG_RANDOM_3
API_KEY=CHANGE_ME_API_KEY

# Opsional (default sudah oke)
INBOX_ACCESS_TOKEN_TTL=15m
INBOX_UNLOCK_MAX_ATTEMPTS=5
INBOX_UNLOCK_WINDOW_MS=60000
PUBLIC_RESERVATION_MAX_PER_IP=5
PUBLIC_RESERVATION_TTL_DAYS=7
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
API_RATE_LIMIT_MAX=5000
MAX_EMAIL_BYTES=1048576
INBOX_LIST_LIMIT=20
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Telegram (opsional, kosongkan = bot mati; aman untuk multi-replica)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHANNEL_ID=

# Mode sync Postfix host (wajib 'external' untuk arsitektur Coolify hybrid).
# Dengan ini, tambah/verifikasi/aktifkan domain cukup dari Admin Dashboard —
# Postfix di host disinkron otomatis oleh watcher cron tiap 2 menit.
# (Jangan isi 'true' di POSTFIX_SYNC_ENABLED: sudo tidak tersedia di container.)
POSTFIX_SYNC_MODE=external
